DATABASE_URL=postgres://extrawork:extrawork@127.0.0.1:54329/extrawork
EXTRAWORK_BIND=127.0.0.1:8081
EXTRAWORK_ROOT=.
METERLESS_URL=http://127.0.0.1:8091
METERLESS_PORT=8091

# Zetaris. Pick the surface that matches the URL you were given.
# gateway (default): managed-cluster Gateway origin, e.g. https://cluster.example.com
# rest: documented REST base, e.g. http://cluster.example.com:8888/api/v1.0
# saas: Zetaris Cloud API origin, e.g. https://api.saas.enterprise.zetaris.com
ZETARIS_API_STYLE=gateway
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
# Use an API key, or username + password for the Gateway login.
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_PROJECT_TABLE=project_lines
ZETARIS_EVIDENCE_TABLE=evidence_extracts

# NVIDIA Nemotron. The default gateway is Nebius Token Factory; any
# OpenAI-compatible endpoint works. A direct NVIDIA key can use:
#   NEMOTRON_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_API_KEY=
NEMOTRON_URL=https://api.tokenfactory.nebius.com/v1/chat/completions
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NVIDIA_API_KEY is accepted as a fallback name.
NVIDIA_API_KEY=
